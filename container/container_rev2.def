Bootstrap: oras
From: mooseharbor.hpc.inl.gov/relap5-base/relap5-base:rocky8.6-intel2.1.8-10

%post
    set -e

    dnf install -y \
        dnf-plugins-core \
        wget \
        xz \
        fd-find \
        ripgrep

    dnf config-manager --set-enabled powertools || true
    dnf makecache

    /opt/uv/bin/uv pip install --no-cache --python /opt/python/bin/python \
        matplotlib \
        numpy \
        scipy \
        pandas

    dnf install -y intel-oneapi-mkl-devel

    # GCC 12 toolset
    dnf install -y \
        gcc-toolset-12 \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        gcc-toolset-12-gcc-gfortran

    mkdir -p /opt/gcc-12/bin

    ln -sf /opt/rh/gcc-toolset-12/root/usr/bin/gcc      /opt/gcc-12/bin/gcc
    ln -sf /opt/rh/gcc-toolset-12/root/usr/bin/g++      /opt/gcc-12/bin/g++
    ln -sf /opt/rh/gcc-toolset-12/root/usr/bin/gfortran /opt/gcc-12/bin/gfortran

    # fd-find installs as fdfind on RHEL/Rocky
    ln -sf /usr/bin/fdfind /usr/local/bin/fd

    # clang
    dnf install -y clang

    # flang
    dnf install -y ninja-build
    mkdir -p ~/llvm-workspace
    cd ~/llvm-workspace

        # Clone LLVM project (using the main branch or a specific release tag)
    git clone https://github.com/llvm/llvm-project.git
    cd llvm-project
    git fetch --tags
    git checkout -b v18 a255c1e

    mkdir -p build
    cd build

    cmake -G "Unix Makefiles" \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_ENABLE_PROJECTS="clang;flang;mlir;lld" \
    -DLLVM_ENABLE_RUNTIMES="flang-rt;openmp" \
    -DCMAKE_INSTALL_PREFIX=/usr/local/llvm-flang \
    ../llvm

    # Compile the toolchain
    make -j 4

    # Install to the specified prefix directory
    make install

    # Clean up
    /opt/uv/bin/uv cache clean
    dnf clean all
    rm -rf /var/cache/dnf

%environment
    export MKLROOT=/opt/intel/oneapi/mkl/latest
    export MKL_DIR=$MKLROOT/lib/cmake/mkl
    export CMAKE_PREFIX_PATH=$MKLROOT:$CMAKE_PREFIX_PATH
    export LD_LIBRARY_PATH=$MKLROOT/lib:$LD_LIBRARY_PATH
    export LIBRARY_PATH=$MKLROOT/lib:$LIBRARY_PATH
    export CPATH=$MKLROOT/include:$CPATH

    export PATH=/opt/python/bin:$PATH

    export PATH=/opt/gcc-12/bin:$PATH
    export LD_LIBRARY_PATH=/opt/rh/gcc-toolset-12/root/usr/lib64:$LD_LIBRARY_PATH

    export LIBRARY_PATH=/usr/local/llvm-flang/lib:$LIBRARY_PATH
    export PATH=/usr/local/llvm-flang/bin:$PATH
